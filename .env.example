# App URLs
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173

# Database
DB_PASSWORD=timecapsule_dev

# JWT (min 32 chars)
JWT_SECRET=changeme_at_least_32_chars_long_secret

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ADDRESS=your@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password

# AWS credentials
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# AWS S3
S3_BUCKET=your-s3-bucket-name
FILE_FOLDER_NAME=files
DATA_FOLDER_NAME=data
AWS_S3_PRESIGNED_URL_EXPIRATION_MS=3600000

# AWS EventBridge + Lambda
LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:your-lambda
SCHEDULER_ROLE_ARN=arn:aws:iam::123456789012:role/your-scheduler-role
